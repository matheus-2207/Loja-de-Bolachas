// Configuração do Prisma para Supabase (PostgreSQL)
// Transaction Pooler — use pgbouncer=true na DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Modelo de produto (bolacha artesanal)
model Produto {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  preco     Decimal  @db.Decimal(10, 2)
  categoria String?
  imagem    String?  // URL do Cloudinary ou caminho local
  estoque   Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens ItensDosPedidos[]

  @@map("produtos")
}

// Status possíveis de um pedido
enum StatusPedido {
  PENDENTE
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  ENVIADO
  ENTREGUE
  CANCELADO
}

// Pedido realizado pelo cliente
model Pedido {
  id           String       @id @default(cuid())
  status       StatusPedido @default(PENDENTE)
  total        Decimal      @db.Decimal(10, 2)
  frete        Decimal      @default(0) @db.Decimal(10, 2)
  cep          String?
  bairro       String?
  logradouro   String?
  nomeCliente  String?
  emailCliente String?
  telefone     String?
  // Identificador opcional de uma transação registrada pela loja
  pagamentoId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  itens ItensDosPedidos[]

  @@map("pedidos")
}

// Itens de cada pedido (relação produto <-> pedido)
model ItensDosPedidos {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String
  quantidade Int
  preco      Decimal @db.Decimal(10, 2) // Preço no momento da compra

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_dos_pedidos")
}
