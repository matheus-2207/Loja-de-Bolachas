# Variáveis de ambiente — copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local!

# Banco de dados (Supabase)
# Use a URL do Transaction Pooler em DATABASE_URL e a conexão direta em DIRECT_URL.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST_POOLER:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST_DIRETO:5432/postgres?sslmode=require"

# Cloudinary
CLOUDINARY_CLOUD_NAME="seu_cloud_name_aqui"
CLOUDINARY_API_KEY="sua_api_key_aqui"
CLOUDINARY_API_SECRET="seu_api_secret_aqui"

# URL da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
